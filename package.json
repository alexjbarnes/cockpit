{
  "name": "@alexjbarnes/cockpit",
  "version": "0.11.0",
  "description": "Web UI for Claude Code: parallel sessions on any device, scheduled jobs, PR reviews, and any model provider",
  "license": "Apache-2.0",
  "author": "Alex Barnes (https://github.com/alexjbarnes)",
  "homepage": "https://github.com/alexjbarnes/cockpit#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexjbarnes/cockpit.git"
  },
  "bugs": {
    "url": "https://github.com/alexjbarnes/cockpit/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "anthropic",
    "ai",
    "ai-agents",
    "web-ui",
    "self-hosted",
    "openrouter",
    "scheduled-jobs",
    "pr-review",
    "mcp"
  ],
  "bin": {
    "cockpit": "./bin/cockpit.js"
  },
  "files": [
    "dist/",
    ".next/BUILD_ID",
    ".next/*.json",
    ".next/*.js",
    ".next/build/",
    ".next/server/",
    ".next/static/",
    "public/",
    "bin/",
    "next.config.ts",
    "postcss.config.mjs"
  ],
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env.development server.ts",
    "build": "unset TURBOPACK && next build --webpack && rm -rf dist && tsc -p tsconfig.server.json && tsc-alias -p tsconfig.server.json",
    "start": "NODE_ENV=production node --env-file=.env.production dist/server.js",
    "lint": "biome check src/ tests/ server.ts",
    "lint:fix": "biome check --fix src/ tests/ server.ts",
    "format": "biome format --write src/ tests/ server.ts",
    "pretest:integration": "npm run build",
    "test:integration": "playwright test --config=tests/integration/playwright.config.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@lezer/highlight": "^1.2.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@pierre/diffs": "1.6.4",
    "@pierre/highlights": "0.4.0",
    "@pierre/theme": "^2.0.0",
    "@pierre/trees": "1.0.0-beta.6",
    "@radix-ui/react-slot": "^1.3.1",
    "@tailwindcss/postcss": "^4",
    "class-variance-authority": "^0.7",
    "clsx": "^2",
    "codemirror": "^6.0.2",
    "ghostty-web": "0.4.0",
    "highlight.js": "11.12.0",
    "lucide-react": "^1.26.0",
    "next": "16.4.5",
    "node-pty": "^1.2.0-beta.13",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4",
    "uuid": "^14.0.0",
    "web-push": "^4.0.0",
    "ws": "^8"
  },
  "overrides": {
    "postcss": "^8.5.12"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/typography": "^0.5.20",
    "@types/node": "^26.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8",
    "@vitest/coverage-v8": "^5.0.3",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "7.0.2",
    "vitest": "^5.0.3"
  }
}
